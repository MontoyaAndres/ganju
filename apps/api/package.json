{
  "name": "api",
  "version": "0.0.1",
  "scripts": {
    "build": "node scripts/builder-docs.mjs && node esbuild.config.mjs && tsc --emitDeclarationOnly",
    "dev": "../../scripts/wrangler-dev.sh apps/api 8080",
    "start": "node ./dist/index.js",
    "clean": "rm -rf dist && rm -rf node_modules",
    "check-queue-retries": "node ../../scripts/check-queue-retries.mjs",
    "deploy-dev": "npm run check-queue-retries && wrangler deploy --env development",
    "deploy-prod": "npm run check-queue-retries && wrangler deploy --env production"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@better-auth/oauth-provider": "^1.7.18",
    "@cfworker/json-schema": "^4.1.6",
    "@ganju/containers": "*",
    "@ganju/db": "*",
    "@ganju/sdk": "*",
    "@ganju/utils": "*",
    "@google/genai": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "better-auth": "^1.7.18",
    "diff": "^8.0.4",
    "hono": "^4.13.17",
    "openai": "^7.54.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261109.1",
    "@ganju/tsconfig": "*",
    "@types/node": "^26.6.6",
    "esbuild": "^0.28.2",
    "fast-glob": "^3.3.3",
    "typescript": "^7.0.2"
  }
}
