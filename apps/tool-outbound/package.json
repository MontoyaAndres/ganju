  },
  "dependencies": {
    "@ganju/utils": "*"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260611.1",
    "@ganju/tsconfig": "*",
    "@types/node": "^25.9.3",
    "esbuild": "^0.28.0",
    "fast-glob": "^3.3.3",
    "typescript": "^6.0.3"
  }
}
