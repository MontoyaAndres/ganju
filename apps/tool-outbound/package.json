{
  "name": "tool-outbound",
  "version": "0.0.1",
  "scripts": {
    "build": "node esbuild.config.mjs && tsc --emitDeclarationOnly",
    "dev": "../../scripts/wrangler-dev.sh apps/tool-outbound 8084",
