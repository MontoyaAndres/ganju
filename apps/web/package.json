{
  "name": "web",
  "version": "0.0.1",
  "scripts": {
    "build": "node scripts/copy-monaco.mjs && next build",
    "dev": "node scripts/copy-monaco.mjs && dotenv -e ../../.env next dev",
    "start": "next start",
    "clean": "rm -rf .next && rm -rf .open-next && rm -rf node_modules",
    "cf-build": "opennextjs-cloudflare build && node scripts/strip-server-env.mjs",
    "deploy-dev": "opennextjs-cloudflare deploy --env development",
    "deploy-prod": "opennextjs-cloudflare deploy --env production",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@better-auth/oauth-provider": "^1.7.18",
    "@ganju/sdk": "*",
    "@ganju/ui": "*",
    "@ganju/utils": "*",
    "@monaco-editor/react": "^4.7.0",
    "@mui/x-data-grid": "^9.17.0",
    "better-auth": "^1.7.18",
    "chart.js": "^4.6.1",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "swr": "^2.5.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@ganju/tsconfig": "*",
    "@opennextjs/cloudflare": "^1.20.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "monaco-editor": "^0.57.0",
    "typescript": "^7.0.2"
  }
}
