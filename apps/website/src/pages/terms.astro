---
import Base from '../layouts/Base.astro';
import { breadcrumbSchema } from '../lib/site';
// The Markdown file is the single source of truth: this page renders it, and
// /terms.md serves the same file raw to agents.
import { Content } from '../md/terms.md';

const description =
  'The terms that govern the hosted Ganju service — accounts, plans and billing, acceptable use, AI output, liability, and termination. The source code stays Apache-2.0.';

const alternates = { en: '/terms', es: '/es/terminos' };

const jsonLd = breadcrumbSchema([
  { label: 'Home', href: '/' },
  { label: 'Terms', href: '/terms' }
]);
---

<Base
  title="Terms of Service"
  {description}
  mdPath="/terms.md"
  {jsonLd}
  {alternates}
>
  <section class="section">
    <article class="container narrow prose">
      <Content />
    </article>
  </section>
</Base>
