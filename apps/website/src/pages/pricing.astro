---
import Base from '../layouts/Base.astro';
import { SITE, PRICING_SCHEMA, breadcrumbSchema, faqSchema } from '../lib/site';
import PricingCalculator from '../components/react/PricingCalculator.tsx';
import { PRICING } from '../lib/pricing';
import { CALCULATOR } from '../lib/i18n';

const description =
  'Ganju pricing: start free, move to Pro for $29 a month when your bot gets real use, or self-host for free under Apache-2.0.';

// Every answer restates a fact already on this page; keep them in sync.
const faqs = [
  {
    q: 'Is there a free plan?',
    a: 'Yes. Free is $0 a month: one project with 100 bot replies a month on our AI model, 7 tools, 3 prompts, 1 channel and 5 MB of searchable content. No card needed.'
  },
  {
    q: 'What happens when I go past the Free limits?',
    a: 'Your bot pauses until the next month starts, or until you move to Pro. Nothing is deleted.'
  },
  {
    q: 'How much does Pro cost?',
    a: 'Pro is $29 a month. It includes 3,000 bot replies (up to 1,000 of them on our AI model), 1 GB of searchable content, 1,000,000 calls to your own functions and 1,000 Assistant credits. You only pay more if you go past one of those.'
  },
  {
    q: 'What counts as a reply?',
    a: 'Each answer your bot sends in a channel like Telegram, WhatsApp, Slack or Discord. Messages people send to your bot are free, and so is using Ganju from Claude, ChatGPT or Cursor.'
  },
  {
    q: 'Why are replies on your AI model more expensive?',
    a: 'On our model we pay for the AI. On your own key you pay your AI provider directly, so the $2 per 1,000 only covers running the tools and the conversation. Add your key for Anthropic, OpenAI or Google Gemini in Settings to use the lower rate.'
  },
  {
    q: 'How do Assistant credits work?',
    a: 'One credit is one cent of AI cost, and building a new action usually takes 25 to 50. Pro includes 1,000 a month; past that it is $2 per 100, up to a monthly limit you set (2,000 extra unless you change it). On your own Anthropic key the Assistant uses no credits.'
  },
  {
    q: 'Is the database charged?',
    a: 'Not yet. On Pro and Enterprise each project gets a database of up to 9 GB and 50 tables. Its usage is measured and shown on your billing page, but not billed. On Free, an existing database stays readable but not editable.'
  },
  {
    q: 'Can I cancel any time?',
    a: 'Yes. Pro keeps working until the end of the period you paid for, then the organization goes back to the Free limits. Your project databases are kept, read-only.'
  },
  {
    q: 'Can I self-host Ganju for free?',
    a: 'Yes. Ganju is open source under Apache-2.0. Deploy it to your own Cloudflare account at no cost, with your own AI keys, and your data stays in your account.'
  }
];

const cards = [
  {
    tier: 'Free',
    amount: '$0',
    per: '/mo',
    sub: 'Try Ganju with one bot.',
    items: [
      '1 project',
      '100 bot replies a month',
      '7 tools, 3 prompts, 1 channel',
      '5 MB of searchable content',
      'Use it from Claude, ChatGPT or Cursor'
    ],
    cta: { label: 'Start free', href: SITE.appUrl, external: true, primary: false }
  },
  {
    tier: 'Pro',
    amount: '$29',
    per: '/mo',
    sub: 'For a bot people use every day.',
    ribbon: 'Most popular',
    items: [
      'Unlimited projects, prompts and channels',
      '3,000 bot replies a month',
      '1 GB of searchable content',
      'The Assistant builds actions for you',
      'Functions and a database per project',
      'Invite your team and use your own AI model'
    ],
    cta: { label: 'Start Pro', href: SITE.appUrl, external: true, primary: true }
  },
  {
    tier: 'Enterprise',
    amount: 'Custom',
    per: '',
    sub: 'For larger teams with their own terms.',
    items: [
      'Everything in Pro',
      'Allowances and contract set with you',
      'A custom web address',
      'A named contact for support'
    ],
    cta: { label: 'Contact sales', href: '/contact/', external: false, primary: false }
  }
];

// Pro only. Mirrors the PRICING_* constants in @ganju/utils.
const usage = [
  ['Bot replies on your own AI key', '3,000', '$2 per 1,000'],
  ['Bot replies on our AI model', '1,000 of those 3,000', '$15 per 1,000'],
  ['Searchable content', '1 GB', '$2 per GB'],
  ['Calls to your own functions', '1,000,000', '$5 per million'],
  ['Assistant credits', '1,000', '$2 per 100, up to a limit you set'],
  ['Custom web address', 'Optional', '$15 a month']
];

const free = [
  'Messages people send to your bot',
  'Using Ganju from Claude, ChatGPT or Cursor',
  'Catalog integrations and remote MCP servers',
  'File storage',
  'The project database (measured, not billed yet)'
];

const yes = '✓';
const compare = [
  ['Price', '$0', '$29 / mo', 'Custom'],
  ['Projects', '1', 'Unlimited', 'Unlimited'],
  ['Bot replies included', '100 / mo', '3,000 / mo', 'Custom'],
  ['Past the included replies', 'Bot pauses', 'Billed as usage', 'Custom'],
  ['Searchable content', '5 MB', '1 GB, then $2 / GB', 'Custom'],
  ['File storage', '30 MB', 'Unlimited', 'Unlimited'],
  ['Prompts per project', '3', 'Unlimited', 'Unlimited'],
  ['Tools switched on', '7', 'Up to 40 per channel', 'Up to 40 per channel'],
  ['HTTP endpoints per project', '3', 'Unlimited', 'Unlimited'],
  ['Channels per project', '1', 'Unlimited', 'Unlimited'],
  ['Automatic resource sync', 'By hand', 'Daily or weekly', 'Daily or weekly'],
  ['The Assistant', '', '1,000 credits / mo', yes],
  ['Functions', '', '1M calls / mo', yes],
  ['Database per project', '', '9 GB, 50 tables', yes],
  ['Invite your team', '', yes, yes],
  ['Bring your own AI model', '', yes, yes],
  ['Support', 'Community', '24/7', 'Named contact']
];

const alternates = { en: '/pricing', es: '/es/precios' };

const jsonLd = [
  PRICING_SCHEMA,
  faqSchema(faqs),
  breadcrumbSchema([
    { label: 'Home', href: '/' },
    { label: 'Pricing', href: '/pricing/' }
  ])
];
---

<Base title="Pricing" description={description} mdPath="/pricing.md" {jsonLd} {alternates}>
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Pricing</span>
        <h1>Simple pricing. Start free.</h1>
        <p>Try it for free. Move to Pro when your bot gets real use. You only pay more if you go past what's included.</p>
      </div>

      <div class="pricing-grid">
        {
          cards.map((card) => (
            <article class:list={['price-card reveal', { 'price-featured': card.ribbon }]}>
              {card.ribbon && <span class="ribbon">{card.ribbon}</span>}
              <h2 class="tier">{card.tier}</h2>
              <div class="price">
                <span class="amount">{card.amount}</span>
                {card.per && <span class="per">{card.per}</span>}
              </div>
              <p class="tier-sub">{card.sub}</p>
              <ul class="price-features">
                {card.items.map((item) => <li>{item}</li>)}
              </ul>
              <a
                class:list={['btn btn-block', card.cta.primary ? 'btn-primary' : 'btn-ghost']}
                href={card.cta.href}
                {...(card.cta.external ? { target: '_blank', rel: 'noopener' } : {})}
              >
                {card.cta.label}
              </a>
            </article>
          ))
        }
      </div>
      <p class="pricing-note reveal">
        Prefer to run it yourself? Ganju is open source. <a href="/docs/deploy/">Self-host it for free</a>.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container narrow">
      <div class="section-head reveal">
        <span class="eyebrow">How Pro is billed</span>
        <h2>$29 covers the month</h2>
        <p>Each item below has an amount included. You only pay extra for what goes past it.</p>
      </div>
      <div class="plan-table-wrap reveal">
        <table class="plan-table">
          <thead>
            <tr><th>What</th><th>Included each month</th><th>After that</th></tr>
          </thead>
          <tbody>
            {usage.map(([what, included, after]) => (
              <tr><th scope="row">{what}</th><td>{included}</td><td>{after}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="plan-free reveal">
        <h3>Always free, on every plan</h3>
        <ul class="price-features">
          {free.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <div class="section-head reveal">
        <span class="eyebrow">Compare plans</span>
        <h2>Everything side by side</h2>
      </div>
      <div class="plan-table-wrap reveal">
        <table class="plan-table plan-compare">
          <thead>
            <tr><th></th><th>Free</th><th>Pro</th><th>Enterprise</th></tr>
          </thead>
          <tbody>
            {compare.map(([row, ...cells]) => (
              <tr>
                <th scope="row">{row}</th>
                {cells.map((cell) => <td>{cell || <span class="plan-no" aria-label="Not included">–</span>}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container narrow">
      <div class="section-head reveal">
        <span class="eyebrow">Estimate your bill</span>
        <h2>What would Pro cost me?</h2>
        <p>Pick a starting point or move the sliders. Stay within what's included and you pay $29.</p>
      </div>
      <PricingCalculator config={PRICING} copy={CALCULATOR.en} client:visible />
    </div>
  </section>

  <section class="section" id="faq">
    <div class="container narrow">
      <div class="section-head reveal">
        <span class="eyebrow">FAQ</span>
        <h2>Pricing questions</h2>
      </div>

      <div class="faq">
        {
          faqs.map((item) => (
            <details class="reveal">
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container narrow">
      <div class="section-head reveal">
        <span class="eyebrow">Still deciding?</span>
        <h2>Not sure which plan fits?</h2>
        <p>Tell us what you're building and we'll help you pick, or set up a custom plan for a bigger team.</p>
      </div>
      <div class="hero-cta center reveal">
        <a class="btn btn-primary btn-lg" href="/contact/">Contact us</a>
        <a class="btn btn-ghost btn-lg" href={SITE.appUrl} target="_blank" rel="noopener">Start free</a>
      </div>
    </div>
  </section>
</Base>
