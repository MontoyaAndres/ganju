---
import Base from '../layouts/Base.astro';
import { breadcrumbSchema } from '../lib/site';
// The Markdown file is the single source of truth: this page renders it, and
// /privacy.md serves the same file raw to agents.
import { Content } from '../md/privacy.md';

const description =
  'How Ganju collects, uses, stores, and shares data in the hosted service — including the Google user data our Gmail, Drive, and Calendar tools access, what goes to AI model providers, what we log, and how to delete it.';

const alternates = { en: '/privacy', es: '/es/privacidad' };

const jsonLd = breadcrumbSchema([
  { label: 'Home', href: '/' },
  { label: 'Privacy', href: '/privacy' }
]);
---

<Base
  title="Privacy Policy"
  {description}
  mdPath="/privacy.md"
  {jsonLd}
  {alternates}
>
  <section class="section">
    <article class="container narrow prose">
      <Content />
    </article>
  </section>
</Base>
