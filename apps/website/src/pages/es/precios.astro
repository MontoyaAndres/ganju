---
import Base from '../../layouts/Base.astro';
import { SITE, PRICING_SCHEMA_ES, breadcrumbSchema, faqSchema } from '../../lib/site';
import PricingCalculator from '../../components/react/PricingCalculator.tsx';
import { PRICING } from '../../lib/pricing';
import { CALCULATOR } from '../../lib/i18n';

const description =
  'Precios de Ganju: empieza gratis, pasa a Pro por $29 al mes cuando tu bot tenga uso real, o instálalo tú mismo sin costo bajo Apache-2.0.';

// Cada respuesta repite un dato que ya está en esta página; mantenlas sincronizadas.
const faqs = [
  {
    q: '¿Hay un plan gratis?',
    a: 'Sí. Free cuesta $0 al mes: un proyecto con 100 respuestas del bot al mes en nuestro modelo de IA, 7 herramientas, 3 prompts, 1 canal y 5 MB de contenido consultable. No necesitas tarjeta.'
  },
  {
    q: '¿Qué pasa si paso los límites de Free?',
    a: 'Tu bot se pausa hasta que empiece el mes siguiente, o hasta que pases a Pro. No se borra nada.'
  },
  {
    q: '¿Cuánto cuesta Pro?',
    a: 'Pro cuesta $29 al mes. Incluye 3.000 respuestas del bot (hasta 1.000 de ellas en nuestro modelo de IA), 1 GB de contenido consultable, 1.000.000 de llamadas a tus propias funciones y 1.000 créditos del Asistente. Solo pagas más si te pasas de alguno.'
  },
  {
    q: '¿Qué cuenta como una respuesta?',
    a: 'Cada respuesta que tu bot envía en un canal como Telegram, WhatsApp, Slack o Discord. Los mensajes que la gente le manda a tu bot son gratis, y también usar Ganju desde Claude, ChatGPT o Cursor.'
  },
  {
    q: '¿Por qué cuestan más las respuestas en su modelo de IA?',
    a: 'Con nuestro modelo, nosotros pagamos la IA. Con tu propia clave le pagas directamente a tu proveedor de IA, así que los $2 por cada 1.000 solo cubren ejecutar las herramientas y la conversación. Agrega tu clave de Anthropic, OpenAI o Google Gemini en Configuración para usar la tarifa más baja.'
  },
  {
    q: '¿Cómo funcionan los créditos del Asistente?',
    a: 'Un crédito es un centavo de costo de IA, y crear una acción nueva suele tomar entre 25 y 50. Pro incluye 1.000 al mes; después son $2 por cada 100, hasta el límite mensual que elijas (2.000 extra si no lo cambias). Con tu propia clave de Anthropic, el Asistente no gasta créditos.'
  },
  {
    q: '¿Se cobra la base de datos?',
    a: 'Todavía no. En Pro y Enterprise cada proyecto tiene una base de datos de hasta 9 GB y 50 tablas. Su consumo se mide y aparece en tu página de facturación, pero no se cobra. En Free, una base de datos que ya exista se puede leer pero no editar.'
  },
  {
    q: '¿Puedo cancelar cuando quiera?',
    a: 'Sí. Pro sigue funcionando hasta el final del periodo que pagaste, y después la organización vuelve a los límites de Free. Las bases de datos de tus proyectos se conservan, en solo lectura.'
  },
  {
    q: '¿Puedo instalar Ganju por mi cuenta gratis?',
    a: 'Sí. Ganju es software libre bajo Apache-2.0. Despliégalo en tu propia cuenta de Cloudflare sin costo, con tus propias claves de IA, y tus datos se quedan en tu cuenta.'
  }
];

const cards = [
  {
    tier: 'Free',
    amount: '$0',
    per: '/mes',
    sub: 'Prueba Ganju con un bot.',
    items: [
      '1 proyecto',
      '100 respuestas del bot al mes',
      '7 herramientas, 3 prompts, 1 canal',
      '5 MB de contenido consultable',
      'Úsalo desde Claude, ChatGPT o Cursor'
    ],
    cta: { label: 'Empieza gratis', href: SITE.appUrl, external: true, primary: false }
  },
  {
    tier: 'Pro',
    amount: '$29',
    per: '/mes',
    sub: 'Para un bot que la gente usa todos los días.',
    ribbon: 'El más elegido',
    items: [
      'Proyectos, prompts y canales ilimitados',
      '3.000 respuestas del bot al mes',
      '1 GB de contenido consultable',
      'El Asistente crea las acciones por ti',
      'Funciones y una base de datos por proyecto',
      'Invita a tu equipo y usa tu propio modelo de IA'
    ],
    cta: { label: 'Empezar con Pro', href: SITE.appUrl, external: true, primary: true }
  },
  {
    tier: 'Enterprise',
    amount: 'A la medida',
    per: '',
    sub: 'Para equipos grandes con sus propias condiciones.',
    items: [
      'Todo lo de Pro',
      'Cupos y contrato acordados contigo',
      'Una dirección web propia',
      'Un contacto asignado para soporte'
    ],
    cta: { label: 'Hablar con ventas', href: '/es/contacto/', external: false, primary: false }
  }
];

// Solo Pro. Refleja las constantes PRICING_* de @ganju/utils.
const usage = [
  ['Respuestas del bot con tu propia clave de IA', '3.000', '$2 por cada 1.000'],
  ['Respuestas del bot en nuestro modelo de IA', '1.000 de esas 3.000', '$15 por cada 1.000'],
  ['Contenido consultable', '1 GB', '$2 por GB'],
  ['Llamadas a tus propias funciones', '1.000.000', '$5 por millón'],
  ['Créditos del Asistente', '1.000', '$2 por cada 100, hasta el límite que elijas'],
  ['Dirección web propia', 'Opcional', '$15 al mes']
];

const free = [
  'Los mensajes que la gente le manda a tu bot',
  'Usar Ganju desde Claude, ChatGPT o Cursor',
  'Las integraciones del catálogo y los servidores MCP remotos',
  'El almacenamiento de archivos',
  'La base de datos del proyecto (se mide, todavía no se cobra)'
];

const yes = '✓';
const compare = [
  ['Precio', '$0', '$29 / mes', 'A la medida'],
  ['Proyectos', '1', 'Ilimitados', 'Ilimitados'],
  ['Respuestas del bot incluidas', '100 / mes', '3.000 / mes', 'A la medida'],
  ['Pasadas las incluidas', 'El bot se pausa', 'Se cobran por consumo', 'A la medida'],
  ['Contenido consultable', '5 MB', '1 GB, luego $2 / GB', 'A la medida'],
  ['Almacenamiento de archivos', '30 MB', 'Ilimitado', 'Ilimitado'],
  ['Prompts por proyecto', '3', 'Ilimitados', 'Ilimitados'],
  ['Herramientas encendidas', '7', 'Hasta 40 por canal', 'Hasta 40 por canal'],
  ['Endpoints HTTP por proyecto', '3', 'Ilimitados', 'Ilimitados'],
  ['Canales por proyecto', '1', 'Ilimitados', 'Ilimitados'],
  ['Sincronización automática de recursos', 'A mano', 'Diaria o semanal', 'Diaria o semanal'],
  ['El Asistente', '', '1.000 créditos / mes', yes],
  ['Funciones', '', '1M de llamadas / mes', yes],
  ['Base de datos por proyecto', '', '9 GB, 50 tablas', yes],
  ['Invitar a tu equipo', '', yes, yes],
  ['Usar tu propio modelo de IA', '', yes, yes],
  ['Soporte', 'Comunidad', '24/7', 'Contacto asignado']
];

const alternates = { en: '/pricing', es: '/es/precios' };

const jsonLd = [
  PRICING_SCHEMA_ES,
  faqSchema(faqs),
  breadcrumbSchema([
    { label: 'Inicio', href: '/es/' },
    { label: 'Precios', href: '/es/precios/' }
  ])
];
---

<Base title="Precios" {description} mdPath="/es/precios.md" {jsonLd} lang="es" {alternates}>
  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <span class="eyebrow">Precios</span>
        <h1>Precios simples. Empieza gratis.</h1>
        <p>Pruébalo gratis. Pasa a Pro cuando tu bot tenga uso real. Solo pagas más si te pasas de lo incluido.</p>
      </div>

      <div class="pricing-grid">
        {
          cards.map((card) => (
            <article class:list={['price-card reveal', { 'price-featured': card.ribbon }]}>
              {card.ribbon && <span class="ribbon">{card.ribbon}</span>}
              <h2 class="tier">{card.tier}</h2>
              <div class="price">
                <span class="amount">{card.amount}</span>
                {card.per && <span class="per">{card.per}</span>}
              </div>
              <p class="tier-sub">{card.sub}</p>
              <ul class="price-features">
                {card.items.map((item) => <li>{item}</li>)}
              </ul>
              <a
                class:list={['btn btn-block', card.cta.primary ? 'btn-primary' : 'btn-ghost']}
                href={card.cta.href}
                {...(card.cta.external ? { target: '_blank', rel: 'noopener' } : {})}
              >
                {card.cta.label}
              </a>
            </article>
          ))
        }
      </div>
      <p class="pricing-note reveal">
        ¿Prefieres correrlo tú mismo? Ganju es software libre. <a href="/es/docs/deploy/">Instálalo gratis</a>.
      </p>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container narrow">
      <div class="section-head reveal">
        <span class="eyebrow">Cómo se cobra Pro</span>
        <h2>Los $29 cubren el mes</h2>
        <p>Cada punto de abajo trae una cantidad incluida. Solo pagas extra por lo que pase de ahí.</p>
      </div>
      <div class="plan-table-wrap reveal">
        <table class="plan-table">
          <thead>
            <tr><th>Qué</th><th>Incluido cada mes</th><th>Después</th></tr>
          </thead>
          <tbody>
            {usage.map(([what, included, after]) => (
              <tr><th scope="row">{what}</th><td>{included}</td><td>{after}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="plan-free reveal">
        <h3>Siempre gratis, en todos los planes</h3>
        <ul class="price-features">
          {free.map((item) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container narrow">
      <div class="section-head reveal">
        <span class="eyebrow">Compara los planes</span>
        <h2>Todo lado a lado</h2>
      </div>
      <div class="plan-table-wrap reveal">
        <table class="plan-table plan-compare">
          <thead>
            <tr><th></th><th>Free</th><th>Pro</th><th>Enterprise</th></tr>
          </thead>
          <tbody>
            {compare.map(([row, ...cells]) => (
              <tr>
                <th scope="row">{row}</th>
                {cells.map((cell) => <td>{cell || <span class="plan-no" aria-label="No incluido">–</span>}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container narrow">
      <div class="section-head reveal">
        <span class="eyebrow">Calcula tu cuenta</span>
        <h2>¿Cuánto me costaría Pro?</h2>
        <p>Elige un punto de partida o mueve los controles. Si te mantienes dentro de lo incluido, pagas $29.</p>
      </div>
      <PricingCalculator config={PRICING} copy={CALCULATOR.es} client:visible />
    </div>
  </section>

  <section class="section" id="faq">
    <div class="container narrow">
      <div class="section-head reveal">
        <span class="eyebrow">Preguntas frecuentes</span>
        <h2>Preguntas sobre precios</h2>
      </div>

      <div class="faq">
        {
          faqs.map((item) => (
            <details class="reveal">
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section-alt">
    <div class="container narrow">
      <div class="section-head reveal">
        <span class="eyebrow">¿Todavía lo estás pensando?</span>
        <h2>¿No sabes qué plan te sirve?</h2>
        <p>Cuéntanos qué estás construyendo y te ayudamos a elegir, o armamos un plan a la medida para un equipo grande.</p>
      </div>
      <div class="hero-cta center reveal">
        <a class="btn btn-primary btn-lg" href="/es/contacto/">Contáctanos</a>
        <a class="btn btn-ghost btn-lg" href={SITE.appUrl} target="_blank" rel="noopener">Empieza gratis</a>
      </div>
    </div>
  </section>
</Base>
