---
import { getEntry, render } from 'astro:content';
import DocsLayout from '../../../layouts/DocsLayout.astro';
import { DOCS } from '../../../lib/i18n';
import { SITE, breadcrumbSchema, techArticleSchema } from '../../../lib/site';

const entry = await getEntry('docsEs', 'welcome');
const { Content } = await render(entry!);
const t = DOCS.es;

const alternates = { en: '/docs', es: '/es/docs' };

const jsonLd = [
  techArticleSchema({
    title: entry!.data.title,
    description: entry!.data.description,
    url: new URL('/es/docs', SITE.url).href,
    updated: entry!.data.updated,
    lang: 'es'
  }),
  breadcrumbSchema([
    { label: 'Inicio', href: '/es/' },
    { label: 'Docs', href: '/es/docs' }
  ])
];
---

{/* Titulada "Documentación", no "Bienvenido" — nadie busca una página de bienvenida. */}
<DocsLayout
  title={t.landingTitle}
  description={entry!.data.description}
  mdPath="/es/docs/welcome.md"
  brand={SITE.name}
  {jsonLd}
  lang="es"
  {alternates}
>
  <article class="prose docs-article">
    <p class="eyebrow">{t.eyebrow}</p>
    <h1>{entry!.data.title}</h1>
    <p class="lead">{entry!.data.description}</p>
    <Content />
  </article>
</DocsLayout>
