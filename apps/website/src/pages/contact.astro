---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE } from '../lib/site';

const description =
  'Get in touch with the Ganju team — questions, sales, support, or feedback. We usually reply within a day.';

const alternates = { en: '/contact', es: '/es/contacto' };
---

<Base title="Contact" {description} {alternates}>
  <section class="section">
    <div class="container narrow">
      <div class="section-head reveal">
        <span class="eyebrow">Contact</span>
        <h1>Talk to us</h1>
        <p>
          Questions about a plan, need a hand, or want something custom? Send us
          a message, we usually reply within a day.
        </p>
      </div>

      <ContactForm />
    </div>
  </section>

  <!-- ===== Open a GitHub issue ===== -->
  <section class="section section-alt">
    <div class="container narrow">
      <div class="section-head reveal">
        <span class="eyebrow">Open source</span>
        <h2>Found a bug or have an idea?</h2>
        <p>
          Ganju is open source. Report bugs and request features on GitHub — we
          read every issue.
        </p>
      </div>
      <div class="hero-cta center reveal">
        <a
          class="btn btn-primary btn-lg"
          href={`${SITE.repo}/issues/new`}
          target="_blank"
          rel="noopener"
        >
          Create a GitHub issue
        </a>
        <a
          class="btn btn-ghost btn-lg"
          href={`${SITE.repo}/issues`}
          target="_blank"
          rel="noopener"
        >
          Browse open issues
        </a>
      </div>
    </div>
  </section>
</Base>
