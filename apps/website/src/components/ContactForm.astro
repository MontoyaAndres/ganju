---
import { SITE } from '../lib/site';
import { CONTACT, toLang } from '../lib/i18n';

interface Props {
  /** BCP-47 tag of the page this form sits on. */
  lang?: string;
}

const lang = toLang(Astro.props.lang);
const t = CONTACT[lang];
---

{/*
  One form, both languages. The submit handler below is language-agnostic: the
  three strings it needs at runtime ride along as `data-` attributes rather than
  being baked into the script, so `/contact` and `/es/contacto` share a single
  bundle instead of shipping a translated copy each.
*/}
<form
  class="contact-form reveal"
  id="contactForm"
  data-endpoint={`${SITE.apiUrl}/contact`}
  data-sending={t.sending}
  data-success={t.success}
  data-failure={t.failure}
>
  <div class="form-field">
    <label for="cf-name">{t.nameLabel}</label>
    <input
      id="cf-name"
      name="name"
      type="text"
      required
      maxlength="200"
      placeholder={t.namePlaceholder}
      autocomplete="organization"
    />
  </div>

  <div class="form-field">
    <label for="cf-email">{t.emailLabel}</label>
    <input
      id="cf-email"
      name="email"
      type="email"
      required
      maxlength="254"
      placeholder={t.emailPlaceholder}
      autocomplete="email"
    />
  </div>

  <div class="form-field">
    <label for="cf-message">{t.messageLabel}</label>
    <textarea
      id="cf-message"
      name="message"
      rows="6"
      required
      maxlength="5000"
      placeholder={t.messagePlaceholder}></textarea>
  </div>

  <!-- Honeypot: hidden from people, catches bots. Leave empty. -->
  <input
    class="hp-field"
    type="text"
    name="company_url"
    tabindex="-1"
    autocomplete="off"
    aria-hidden="true"
  />

  <button class="btn btn-primary btn-lg btn-block" type="submit" id="cf-submit">
    {t.submit}
  </button>

  <p class="form-status" id="cf-status" role="status" aria-live="polite" hidden></p>

  <p class="form-note">
    {t.notePrefix} <a href={`mailto:${SITE.email}`}>{SITE.email}</a>.
  </p>
</form>

<script>
  // POST the form to the API (apps/api → /contact), which emails the team via
  // the Cloudflare send_email binding. No mail client needed on the visitor's end.
  const form = document.getElementById('contactForm') as HTMLFormElement | null;
  const submit = document.getElementById('cf-submit') as HTMLButtonElement | null;
  const status = document.getElementById('cf-status') as HTMLElement | null;

  if (form && submit && status) {
    const copy = (name: string) => form.getAttribute(`data-${name}`) || '';

    form.addEventListener('submit', async e => {
      e.preventDefault();
      if (!form.reportValidity()) return;

      const endpoint = form.getAttribute('data-endpoint') || '';
      const data = new FormData(form);
      const payload = {
        name: String(data.get('name') || '').trim(),
        email: String(data.get('email') || '').trim(),
        message: String(data.get('message') || '').trim(),
        company_url: String(data.get('company_url') || '')
      };

      const label = submit.textContent;
      submit.disabled = true;
      submit.textContent = copy('sending');
      status.hidden = true;
      status.classList.remove('is-error');

      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        if (!res.ok) {
          const data = await res.json().catch(() => null);
          throw new Error((data && data.error) || copy('failure'));
        }
        // Success — swap the form fields for a thank-you message.
        form
          .querySelectorAll('.form-field, .form-note')
          .forEach(el => el.remove());
        submit.remove();
        status.textContent = copy('success');
        status.hidden = false;
      } catch (err) {
        status.textContent = err instanceof Error ? err.message : copy('failure');
        status.classList.add('is-error');
        status.hidden = false;
        submit.disabled = false;
        submit.textContent = label;
      }
    });
  }
</script>
