---
import { SITE, LEGAL } from '../lib/site';
import { HOME, LANG_HREF, UI, toLang } from '../lib/i18n';

interface Props {
  /** BCP-47 tag of the page this footer sits on. */
  lang?: string;
}

const lang = toLang(Astro.props.lang);
const t = UI[lang];
const f = t.footer;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <a href={HOME[lang]} class="brand">
        <span class="brand-mark" aria-hidden="true"></span>
        <span class="brand-name">Ganju</span>
      </a>
      <p>{f.tagline}</p>

      <div class="footer-social">
        <a href={SITE.social.x} target="_blank" rel="noopener" aria-label="Ganju on X">
          <img class="brand-ico" src="/icons/x.svg" alt="X logo" loading="lazy" />
        </a>
        <a href={SITE.social.linkedin} target="_blank" rel="noopener" aria-label="Ganju on LinkedIn">
          <img class="brand-ico" src="/icons/linkedin.svg" alt="LinkedIn logo" loading="lazy" />
        </a>
        <a href={SITE.repo} target="_blank" rel="noopener" aria-label="Ganju on GitHub">
          <img class="brand-ico" src="/icons/github.svg" alt="GitHub logo" loading="lazy" />
        </a>
      </div>
    </div>

    <nav class="footer-col" aria-label={f.product.title}>
      <h4>{f.product.title}</h4>
      {f.product.links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>

    <nav class="footer-col" aria-label={f.resources.title}>
      <h4>{f.resources.title}</h4>
      {f.resources.links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>

    <nav class="footer-col" aria-label={f.legal.title}>
      <h4>{f.legal.title}</h4>
      {f.legal.links.map((link) => <a href={link.href}>{link.label}</a>)}
      <a href="https://www.apache.org/licenses/LICENSE-2.0" target="_blank" rel="noopener">
        {f.legal.license}
      </a>
    </nav>
  </div>
  <div class="container footer-bottom">
    <span>© {year} Ganju.</span>

    {/* Explicit language choice — overrides the geo redirect on `/`. */}
    <nav class="footer-lang" aria-label={f.languageAria}>
      {
        (['en', 'es'] as const).map((code) =>
          code === lang ? (
            <span aria-current="true">{UI[code].label}</span>
          ) : (
            <a href={LANG_HREF[code]} hreflang={code} lang={code}>
              {UI[code].label}
            </a>
          )
        )
      }
    </nav>

    {/* Supplier identity — Ley 1480 de 2011, art. 50. See LEGAL in lib/site.ts. */}
    <address class="footer-legal">
      <span>{LEGAL.entity}</span>
      {LEGAL.nit && <span>NIT {LEGAL.nit}</span>}
      <span>{LEGAL.address}</span>
      <a href={`tel:${LEGAL.phoneHref}`}>{LEGAL.phone}</a>
      <a href={`mailto:${LEGAL.email}`}>{LEGAL.email}</a>
    </address>
  </div>
</footer>
