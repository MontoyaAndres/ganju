---
import { SITE } from '../lib/site';
import { HOME, UI, toLang } from '../lib/i18n';
import { getStarCount } from '../lib/stars';

interface Props {
  /** BCP-47 tag of the page this header sits on. */
  lang?: string;
}

const lang = toLang(Astro.props.lang);
const t = UI[lang];
const stars = await getStarCount();
---

<header class="site-header" id="header">
  <div class="container header-inner">
    <a href={HOME[lang]} class="brand" aria-label={t.brandAria}>
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-name">Ganju</span>
    </a>

    <nav class="nav" id="nav" aria-label={t.navAria}>
      {t.nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>

    <div class="header-actions">
      <a
        class="btn btn-ghost btn-star"
        href={SITE.repo}
        target="_blank"
        rel="noopener"
        aria-label={t.starAria}
      >
        <img class="brand-ico" src="/icons/github.svg" alt="GitHub logo" loading="lazy" />
        {t.star}
        {stars && <span class="star-count" id="starCount">{stars}</span>}
      </a>
      <a class="btn btn-primary" href={SITE.appUrl} target="_blank" rel="noopener">
        {t.getStarted}
      </a>
    </div>

    <button class="nav-toggle" id="navToggle" aria-label={t.menuAria} aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>
