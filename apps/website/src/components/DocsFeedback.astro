---
import { SITE } from '../lib/site';
import { DOCS, toLang } from '../lib/i18n';

interface Props {
  /** BCP-47 tag of the page this block sits on. */
  lang?: string;
}

const t = DOCS[toLang(Astro.props.lang)].feedback;
---

<!-- ===== Open a GitHub issue ===== -->
<section class="section section-alt">
  <div class="container narrow">
    <div class="section-head reveal">
      <span class="eyebrow">{t.eyebrow}</span>
      <h2>{t.heading}</h2>
      <p>{t.body}</p>
    </div>
    <div class="hero-cta center reveal">
      <a
        class="btn btn-primary btn-lg"
        href={`${SITE.repo}/issues/new`}
        target="_blank"
        rel="noopener"
      >
        {t.create}
      </a>
      <a
        class="btn btn-ghost btn-lg"
        href={`${SITE.repo}/issues`}
        target="_blank"
        rel="noopener"
      >
        {t.browse}
      </a>
    </div>
  </div>
</section>
