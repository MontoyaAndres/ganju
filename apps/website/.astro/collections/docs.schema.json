{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "order": {
      "default": 100,
      "type": "number"
    },
    "updated": {
      "type": "string",
      "format": "date-time"
    },
    "minutes": {
      "type": "number"
    },
    "outcome": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "description"
  ]
}