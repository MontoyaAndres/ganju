{
  "name": "@ganju/sdk",
  "version": "0.0.3",
  "description": "The typed `ctx` a Ganju custom tool is written against",
  "license": "Apache-2.0",
  "author": "MontoyaAndres <andresmontoyafcb@gmail.com>",
  "homepage": "https://ganju.ai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MontoyaAndres/ganju.git",
    "directory": "packages/sdk"
  },
  "keywords": [
    "ganju",
    "mcp",
    "model-context-protocol",
    "cloudflare-workers",
    "tools"
  ],
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./workerModule": {
      "types": "./dist/workerModule.d.ts",
      "import": "./dist/workerModule.js",
      "require": "./dist/workerModule.js"
    },
    "./editorTypes": {
      "types": "./dist/editorTypes.d.ts",
      "import": "./dist/editorTypes.js",
      "require": "./dist/editorTypes.js"
    }
  },
  "scripts": {
    "build": "tsc && node scripts/build-worker-module.mjs && node scripts/build-editor-types.mjs",
    "prepublishOnly": "npm run build",
    "clean": "rm -rf dist && rm -rf node_modules"
  },
  "dependencies": {
    "@ganju/utils": "*",
    "@cloudflare/workers-types": "^4.20260611.1"
  },
  "devDependencies": {
    "@ganju/tsconfig": "*",
    "typescript": "^6.0.3",
    "esbuild": "^0.25.0"
  }
}
